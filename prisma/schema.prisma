generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  password      String
  role          String
  createdAt     DateTime      @default(now())
  contactNumber String?
  applications  Application[]
  jobs          Job[]
}

model Job {
  id              Int           @id @default(autoincrement())
  userId          Int
  title           String
  companyName     String
  location        String
  category        String
  jobType         String
  description     String
  requirements    String
  salaryMin       Int
  salaryMax       Int
  salaryCurrency String @default("PKR")
  status          String
  postedAt        DateTime      @default(now())
  companyLocation String
  applications    Application[]
  user            User          @relation(fields: [userId], references: [id])
}

model Application {
  id        Int      @id @default(autoincrement())
  jobId     Int
  userId    Int
  status    String
  appliedAt DateTime @default(now())
  resume    String?
  job       Job      @relation(fields: [jobId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  notes     Note[]
}

model Note {
  id            Int         @id @default(autoincrement())
  applicationId Int
  title         String
  description   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id])
}

enum ApplicationStatus {
  APPLIED
  INTERVIEW
  ACCEPTED
  REJECTED
}
